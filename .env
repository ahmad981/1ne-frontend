# Backend API Configuration — LOCAL DEVELOPMENT
# Active local server (must match uvicorn port, e.g. --port 8001)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000/api

# Railway Production (comment out when developing locally)
# VITE_API_BASE_URL=https://1nebackend-production.up.railway.app
# VITE_API_URL=https://1nebackend-production.up.railway.app/api

# Optional: if you omit VITE_* above, set this to use built-in localhost fallback in src/config/api.ts
# VITE_USE_LOCAL=true
