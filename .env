# Backend API Configuration
# Railway Production Backend URL (commented out – use local for profile/metadata)
# VITE_API_BASE_URL=https://1nebackend-production.up.railway.app
# VITE_API_URL=https://1nebackend-production.up.railway.app/api
# Local backend (port 8001)
VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_API_URL=http://127.0.0.1:8001/api

# Personalization feature flag
# Set to 'true' to enable backend-driven personalization slate for the Learning Hub.
# When 'false', the hub uses existing local data (safe default for incremental rollout).
VITE_PERSONALIZATION_ENABLED=true